# Root types for the schema.

type Query {
    me: User
    users(page: Int, size: Int): UserPage!
    user(id: ID!): User
    roles: [Role!]!
    role(id: ID!): Role
    permissions: [Permission!]!

    categories(page: Int, size: Int): CategoryPage!
    category(id: ID!): Category

    products(categoryId: ID, page: Int, size: Int): ProductPage!
    product(id: ID!): Product

    customers(page: Int, size: Int): CustomerPage!
    customer(id: ID!): Customer

    orders(customerId: ID, page: Int, size: Int): OrderPage!
    order(id: ID!): Order
}

type Mutation {
    register(input: RegisterInput!): AuthPayload!
    activateAccount(token: String!): Boolean!
    login(input: LoginInput!): AuthPayload!
    logout: Boolean!
    refreshToken(token: String!): AuthPayload!
    requestPasswordReset(email: String!): Boolean!
    resetPassword(token: String!, newPassword: String!): Boolean!
    updateProfile(input: UpdateProfileInput!): User!

    createUser(input: CreateUserInput!): User!
    updateUser(id: ID!, input: UpdateUserInput!): User!
    lockUser(id: ID!): User!
    unlockUser(id: ID!): User!
    deleteUser(id: ID!): Boolean!
    updateUserRoles(id: ID!, input: UpdateUserRolesInput!): User!

    createRole(input: RoleInput!): Role!
    updateRole(id: ID!, input: RoleInput!): Role!
    deleteRole(id: ID!): Boolean!
    createPermission(input: PermissionInput!): Permission!
    deletePermission(id: ID!): Boolean!
    updateRolePermissions(roleId: ID!, input: UpdateRolePermissionsInput!): Role!

    createCategory(input: CategoryInput!): Category!
    updateCategory(id: ID!, input: CategoryInput!): Category!
    deleteCategory(id: ID!): Boolean!

    createProduct(input: ProductInput!): Product!
    updateProduct(id: ID!, input: ProductInput!): Product!
    deleteProduct(id: ID!): Boolean!

    createCustomer(input: CustomerInput!): Customer!
    updateCustomer(id: ID!, input: CustomerInput!): Customer!
    deleteCustomer(id: ID!): Boolean!

    createOrder(input: OrderInput!): Order!
}

type Subscription {
    orderCreated: Order!
}

type User {
    id: ID!
    firstName: String!
    lastName: String!
    email: String!
    enabled: Boolean!
    accountLocked: Boolean!
    roles: [Role!]!
}

type Role {
    id: ID!
    roleName: String!
    permissions: [Permission!]!
}

type Permission {
    id: ID!
    resource: String!
    action: String!
}

type UserPage {
    content: [User!]!
    totalElements: Int!
    totalPages: Int!
    page: Int!
    size: Int!
}

type AuthPayload {
    accessToken: String
    tokenType: String
    refreshToken: String
    expiresIn: Int
    user: User!
}

input RegisterInput {
    firstName: String!
    lastName: String!
    email: String!
    password: String!
    confirmPassword: String!
}

input LoginInput {
    email: String!
    password: String!
}

input CreateUserInput {
    firstName: String!
    lastName: String!
    email: String!
    password: String!
}

input UpdateUserInput {
    firstName: String!
    lastName: String!
    email: String!
}

input RoleInput {
    roleName: String!
}

input PermissionInput {
    resource: String!
    action: String!
}

input UpdateProfileInput {
    firstName: String
    lastName: String
    email: String
}

input UpdateRolePermissionsInput {
    add: [ID!]
    remove: [ID!]
}

input UpdateUserRolesInput {
    add: [ID!]
    remove: [ID!]
}

type Category {
    id: ID!
    categoryName: String!
    createdAt: String
    updatedAt: String
}

type CategoryPage {
    content: [Category!]!
    totalElements: Int!
    totalPages: Int!
    page: Int!
    size: Int!
}

input CategoryInput {
    categoryName: String!
}

type Product {
    id: ID!
    productName: String!
    unitPrice: Float!
    version: Int!
    category: Category!
}

type ProductPage {
    content: [Product!]!
    totalElements: Int!
    totalPages: Int!
    page: Int!
    size: Int!
}

input ProductInput {
    productName: String!
    unitPrice: Float!
    categoryId: ID!
}

type Customer {
    id: ID!
    firstName: String!
    lastName: String!
    telephone: String!
    email: String!
    address: String!
}

type CustomerPage {
    content: [Customer!]!
    totalElements: Int!
    totalPages: Int!
    page: Int!
    size: Int!
}

input CustomerInput {
    firstName: String!
    lastName: String!
    telephone: String!
    email: String!
    address: String!
}

type Order {
    id: ID!
    customer: Customer!
    product: Product!
    quantity: Int!
    total: Float!
}

type OrderPage {
    content: [Order!]!
    totalElements: Int!
    totalPages: Int!
    page: Int!
    size: Int!
}

input OrderInput {
    customerId: ID!
    productId: ID!
    quantity: Int!
}
